      "updater": "scripts/version/init-version.js"
    }
  ],
  "bumpFiles": [
    {
      "filename": "pyproject.toml",
      "updater": "scripts/version/pyproject-version.js"
    },
    {
      "filename": "pretix_solverforge_seating/__init__.py",
      "updater": "scripts/version/init-version.js"
    }
  ]
}
